{
    "name": "tallieutallieu/oak",
    "minimum-stability": "dev",
    "description": "Simple PHP building block framework",
    "keywords": ["container", "facade", "dependency injection", "framework", "library"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nyholm/psr7": "^1.0@dev",
        "nyholm/psr7-server": "1.0.2",
        "psr/http-server-handler": "^1.0@dev",
        "psr/http-server-middleware": "^1.0@dev",
        "vlucas/phpdotenv": "^5.6.2",
        "dragonmantank/cron-expression": "3.0.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
      "psr-4": {
        "Oak\\": "src/"
      }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=512M"
    }
}
